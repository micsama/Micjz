{
  "name": "micjz-web",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite --host",
    "demo": "vite --host --mode mock",
    "build": "bun node_modules/vite/bin/vite.js build",
    "format": "prettier --write src mock vite.config.ts",
    "check": "prettier --check src mock vite.config.ts && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@tsconfig/svelte": "^5.0.8",
    "prettier": "3.6.2",
    "prettier-plugin-svelte": "3.4.0",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.0"
  }
}
